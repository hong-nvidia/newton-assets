#usda 1.0
(
    customLayerData = {
        string creator = "unitree_h2/tools/build_structured_usd.py"
    }
    defaultPrim = "H2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "H2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
    kind = "component"
)
{
    custom string isaac:description = "Unitree H2 closed-loop humanoid"
    custom rel isaac:physics:robotJoints = [
