        </H2/Geometry/left_ankle_A_link>,
        </H2/Geometry/left_knee_loop_rod>,
        </H2/Geometry/right_ankle_roll_link>,
        </H2/Geometry/right_ankle_A_link>,
        </H2/Geometry/right_knee_loop_rod>,
        </H2/Geometry/head_yaw_link>,
        </H2/Geometry/left_shoulder_roll_link>,
