        </H2/Joints/right_knee_joint>,
        </H2/Joints/right_knee_motor_joint>,
        </H2/Joints/head_pitch_joint>,
        </H2/Joints/left_shoulder_pitch_joint>,
        </H2/Joints/right_shoulder_pitch_joint>,
        </H2/Joints/torso_constraint_R_joint>,
        </H2/Joints/torso_constraint_L_joint>,
        </H2/Joints/left_hip_yaw_joint>,
        </H2/Joints/right_hip_yaw_joint>,
        </H2/Joints/waist_pitch_joint>,
        </H2/Joints/left_hip_roll_joint>,
        </H2/Joints/right_hip_roll_joint>,
        </H2/Joints/waist_roll_joint>,
        </H2/Joints/left_hip_pitch_joint>,
        </H2/Joints/right_hip_pitch_joint>,
        </H2/Joints/waist_yaw_joint>,
        </H2/Joints/left_ankle_connect>,
        </H2/Joints/right_ankle_connect>,
        </H2/Joints/left_knee_connect>,
        </H2/Joints/right_knee_connect>,
        </H2/Joints/right_waist_connect>,
        </H2/Joints/left_waist_connect>,
    ]
    custom rel isaac:physics:robotLinks = [
        </H2/Geometry/pelvis>,
        </H2/Geometry/left_wrist_yaw_link>,
        </H2/Geometry/right_wrist_yaw_link>,
        </H2/Geometry/left_wrist_pitch_link>,
        </H2/Geometry/right_wrist_pitch_link>,
        </H2/Geometry/left_wrist_roll_link>,
